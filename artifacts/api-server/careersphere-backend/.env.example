# Local development uses H2 by default. Copy to your shell environment as needed.
# Use a unique random value for JWT_SECRET; never commit a real key.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false

# Optional live AI. Leave unset for the clearly-labelled deterministic demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production MySQL configuration (set all four values as environment variables).
# MYSQL_URL=jdbc:mysql://localhost:3306/careersphere?useSSL=true&serverTimezone=UTC
# MYSQL_USERNAME=careersphere
# MYSQL_PASSWORD=
